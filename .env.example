# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit it.
#
# Both values come from the Supabase dashboard:
#   Project Settings -> API
#
# SUPABASE_ANON_KEY must be the **anon / publishable** key. It is safe in a
# client app because row level security decides what it can read. Never put the
# `service_role` key here — it bypasses RLS entirely and would give anyone with
# a copy of the app full access to your database.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
